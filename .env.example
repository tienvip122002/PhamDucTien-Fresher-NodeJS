PORT=3000

# Local: docker compose up -d   |   Cloud: Neon / Supabase connection string
DATABASE_URL=postgres://mini_order:mini_order@localhost:5432/mini_order
# Set to true for managed Postgres (Neon, Supabase)
DATABASE_SSL=false

# Local: redis://localhost:6379/0   |   Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=redis://localhost:6379/0

# true = also run the queue worker inside the API process (handy locally).
# In production keep false and run the worker separately: npm run start:worker
RUN_WORKER=true

# Order processing queue ("order-processing")
ORDER_JOB_ATTEMPTS=3
ORDER_JOB_BACKOFF_MS=1000
ORDER_FAILURE_RATE=0.3
ORDER_PROCESSING_MIN_MS=3000
ORDER_PROCESSING_MAX_MS=5000
WORKER_CONCURRENCY=5
# Only for hosts that require the worker to listen on a port (e.g. Render free web service)
# WORKER_HEALTH_PORT=10000

# Periodic job (every 5 minutes): re-add missing jobs for PENDING orders older than
# REQUEUE_PENDING_AFTER_SECONDS, cancel PENDING orders older than PENDING_ORDER_TTL_MINUTES
PENDING_ORDER_TTL_MINUTES=30
CLEANUP_INTERVAL_MS=300000
REQUEUE_PENDING_AFTER_SECONDS=60
